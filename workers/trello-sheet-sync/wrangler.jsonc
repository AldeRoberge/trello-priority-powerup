{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trello-sheet-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "observability": { "enabled": true },
  // Sheet -> Trello direction: Google Sheets has no push, so the Worker polls once a minute.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "TIMEZONE": "America/Toronto"
  }
  // Secrets (set by scripts/setup-sheet-sync.ps1 via `wrangler secret bulk`):
  // GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_SERVICE_ACCOUNT_KEY, GOOGLE_SHEET_ID,
  // TRELLO_KEY, TRELLO_TOKEN, TRELLO_BOARD_ID, SYNC_SECRET, ALLOWED_ORIGINS
  // Optional: SEARCH_API_KEY (Tavily) = web search for the Entity interview (npm run secret:search)
  // Optional: UNSPLASH_ACCESS_KEY = Unsplash search for document covers (npm run secret:unsplash)
  // Optional (scripts/setup-documents-drive.ps1): GOOGLE_DRIVE_FOLDER_ID = Drive folder that receives the Documents view as .md files
  // Optional, personal Gmail (no Shared Drive): GOOGLE_DRIVE_CLIENT_ID, GOOGLE_DRIVE_CLIENT_SECRET, GOOGLE_DRIVE_REFRESH_TOKEN
  // Optional (npm run secret:timer-email + a KV namespace TIMER_STATE): RESEND_API_KEY, TIMER_EMAIL_TO, TIMER_EMAIL_FROM = email when a card timer ends and no tab announced it
  // Optional (scripts/setup-keep.ps1, Google Workspace only): KEEP_USER_EMAIL = Workspace user whose Keep notes are synced
  //   (domain-wide delegation, scope keep), KEEP_LISTS = tracked note titles separated by | (default in src/keep.js)
  //   so files are created as the user (a service account has no storage quota)
}
